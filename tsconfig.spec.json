{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "isolatedModules": true
  },
  "jsx": "react-jsx",
  "include": ["src/**/*.spec.ts", "src/**/*.test.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
